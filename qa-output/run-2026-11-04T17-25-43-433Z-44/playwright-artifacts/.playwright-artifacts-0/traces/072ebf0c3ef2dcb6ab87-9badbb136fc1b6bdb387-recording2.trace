 gap: 5px;\n}\n.op-card[data-v-6bded037] {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  padding: 5px 9px;\n  border-radius: 6px;\n  font-size: 11px;\n  background: #f7f6f0;\n  border: 1px solid #eae7dc;\n}\n.op-card.op-add[data-v-6bded037] {\n  background: #f0f9ff;\n  border-color: #bae6fd;\n  color: #0369a1;\n}\n.op-card.op-remove[data-v-6bded037] {\n  background: #fef2f2;\n  border-color: #fecaca;\n  color: #b91c1c;\n}\n.op-card.op-update[data-v-6bded037] {\n  background: #fffbeb;\n  border-color: #fde68a;\n  color: #b45309;\n}\n\n/* Mini Preview */\n.mini-preview-container[data-v-6bded037] {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.mini-preview-frame[data-v-6bded037] {\n  height: 120px;\n  background: #faf8f3;\n  border: 1px solid #eae5d7;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  padding: 8px;\n}\n.mini-preview-svg[data-v-6bded037] {\n  width: 100%;\n  height: 100%;\n}\n\n/* Metrics */\n.metrics-grid[data-v-6bded037] {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 6px;\n  background: #f8f6f0;\n  padding: 8px 10px;\n  border-radius: 8px;\n  border: 1px solid #eae6db;\n}\n.metric-item[data-v-6bded037] {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n.metric-num[data-v-6bded037] {\n  font: 700 12px var(--mono, monospace);\n  color: #292a28;\n}\n.metric-name[data-v-6bded037] {\n  font: 9px var(--mono, monospace);\n  color: #85877c;\n  text-transform: uppercase;\n}\n\n/* Diagnostics */\n.diagnostics-bar[data-v-6bded037] {\n  background: #f5f4ed;\n  border-radius: 6px;\n  padding: 6px 10px;\n  font-size: 11px;\n}\n.diagnostics-status[data-v-6bded037] {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n.status-indicator[data-v-6bded037] {\n  width: 7px;\n  height: 7px;\n  border-radius: 999px;\n}\n.diagnostics-status.solvable .status-indicator[data-v-6bded037] { background: #10b981;\n}\n.diagnostics-statu