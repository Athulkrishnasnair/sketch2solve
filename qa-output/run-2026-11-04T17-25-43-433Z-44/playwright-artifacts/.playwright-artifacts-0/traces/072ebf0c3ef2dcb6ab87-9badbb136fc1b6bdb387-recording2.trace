 {\n100% { transform: rotate(360deg);\n}\n}\n.resolve-error-banner[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: #fee2e2;\n  border: 1px solid #fecaca;\n  color: #991b1b;\n  padding: 6px 8px;\n  border-radius: 4px;\n  font-size: 10px;\n}\n.btn-retry-resolve[data-v-64e743d5] {\n  margin-left: auto;\n  border: 1px solid #dc2626;\n  background: #ffffff;\n  color: #dc2626;\n  border-radius: 3px;\n  padding: 1px 5px;\n  font-size: 9px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n/* ─── Docked on Small Screens ─── */\n@media (max-width: 768px) {\n.contextual-action-card[data-v-64e743d5] {\n    left: 12px !important;\n    right: 12px !important;\n    bottom: 12px !important;\n    top: auto !important;\n    width: auto !important;\n    max-width: none !important;\n    max-height: min(420px, calc(100% - 24px)) !important;\n}\n}\n"],["STYLE",{},"\n.analysis-results-panel[data-v-c50f7cc4] {\n  position: relative;\n  width: 100%;\n  flex-shrink: 0;\n  height: 270px;\n  max-height: 42vh;\n  background: #ffffff;\n  border-top: 1px solid var(--color-border, #e9e5d7);\n  box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.08);\n  display: flex;\n  flex-direction: column;\n  z-index: 40;\n  transition: height 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n  font-family: inherit;\n  color: var(--color-text-primary, #252b2c);\n}\n.analysis-results-panel.is-expanded[data-v-c50f7cc4] {\n  height: 420px;\n  max-height: 56vh;\n}\n.analysis-results-panel.is-minimized[data-v-c50f7cc4] {\n  height: 42px;\n  overflow: hidden;\n}\n.analysis-results-panel.is-minimized .panel-body[data-v-c50f7cc4],\n.analysis-results-panel.is-minimized .panel-alert[data-v-c50f7cc4] {\n  display: none !important;\n}\n.analysis-results-panel.is-stale[data-v-c50f7cc4] {\n  border-top: 2px solid #f59e0b;\n}\n\n/* Header */\n.panel-header[data-v-c50f7cc4] {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 16px;\n  background: var(--color-surface, #ff