e; }\n.analysis-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.analysis-card { border: 1px solid #e2e8e3; background: #fff; min-height: 109px; border-radius: 8px; padding: 13px 14px; text-align: left; display: flex; flex-direction: column; cursor: pointer; transition: border-color .15s, box-shadow .15s; }\n.analysis-card:hover { border-color: #b7ccc2; box-shadow: 0 5px 14px rgba(36, 66, 52, .06); }\n.analysis-card-top, .analysis-card-bottom { display: flex; justify-content: space-between; align-items: center; gap: 10px; }\n.analysis-card > strong { font-size: 11px; color: #47524e; font-weight: 700; margin: 11px 0 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.status-badge { border-radius: 20px; display: inline-flex; gap: 6px; align-items: center; padding: 4px 7px; font: 9px var(--mono); white-space: nowrap; }\n.status-badge i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }\n.status-pending, .recent-status.status-pending { color: #987340; background: #f7f0e4; }\n.status-complete, .recent-status.status-complete { color: #3d8272; background: #e9f4ee; }\n.status-failed, .recent-status.status-failed { color: #a9534b; background: #faeeeb; }\n.recent-status.status-pending { background: #d6a762; }\n.recent-status.status-complete { background: #57a186; }\n.recent-status.status-failed { background: #cf7770; }\n.card-id { color: #a5aeaa; font: 8px var(--mono); }\n.analysis-card-bottom { color: #9ba39f; font: 8px var(--mono); }\n.analysis-card-bottom b { color: #648981; font-size: 12px; font-weight: 400; padding-left: 3px; }\n\n.history-page { padding-top: 44px; }\n.compact-heading { align-items: center; margin-bottom: 28px; }\n.compact-heading p { max-width: none; }\n.compact-heading .button { flex: 0 0 auto; }\n.history-list { overflow: hidden; }\n.history-header, .history-row { display: grid; grid-template-columns: minmax(225px, 1.6fr) minmax(145px, 1fr) minmax(125px, 1fr) minmax(12