{"type":"frame-snapshot","snapshot":{"callId":"umke@85","phase":"after","pageId":"page@9810ff495a821cd94a7dd55bbb3a2990","frameId":"frame@c1ae4ba7c8f29e7bcda04dfcf288f343","frameUrl":"http://127.0.0.1:5175/","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:5175/"}],"\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["LINK",{"rel":"icon","type":"image/png","sizes":"32x32","href":"/favicon-32x32.png"}],"\n    ",["LINK",{"rel":"icon","type":"image/png","sizes":"64x64","href":"/favicon.png"}],"\n    ",["LINK",{"rel":"apple-touch-icon","href":"/logo.png"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["META",{"name":"theme-color","content":"#f4f4f1"}],"\n    ",["META",{"name":"description","content":"Sketch2Solve — Intelligent Structural Truss Analysis & Natural Language Design Workbench."}],"\n    ",["TITLE",{},"Sketch2Solve · Structural Truss Engineering"],"\n  ",["STYLE",{},"/* =============================================================================\n   Sketch2Solve — Engineering Workstation Design Tokens\n   Defines all CSS custom properties consumed by the rest of the design system.\n   ============================================================================= */\n\n:root {\n  /* ─── Surface & Background ─── */\n  --color-canvas:           #f8fafc;   /* Engineering canvas background */\n  --color-surface:          #ffffff;   /* Panel and card surfaces */\n  --color-surface-raised:   #f8fafc;   /* Slightly elevated surface (stat cards, chips) */\n  --color-surface-overlay:  rgba(255, 255, 255, 0.92); /* Floating overlay surfaces */\n\n  /* ─── Borders ─── */\n  --color-border:           #e2e8f0;   /* Standard border */\n  --color-border-subtle:    #f1f5f9;   /* Subtle inner border */\n  --color-border-strong:    #cbd5e1;   /* Visible controls border */\n\n  /* ─── Text ─── */\n  --color-text-primary:     #0f172a;   /* Headings, strong labels */\n  --color-text-secondary:   #334155;   /* Body and field text */\n  --color-text-muted:       #64748b;   /* Captions, secondary labels */\n  --color-text-placeholder: #94a3b8;   /* Input placeholder, empty states */\n\n  /* ─── Primary Accent (Blue — actions, selections) ─── */\n  --color-accent:           #0284c7;\n  --color-accent-hover:     #0369a1;\n  --color-accent-active:    #075985;\n  --color-accent-subtle:    #e0f2fe;\n  --color-accent-text:      #0c4a6e;\n\n  /* ─── Success / Valid (Green) ─── */\n  --color-success:          #16a34a;\n  --color-success-hover:    #15803d;\n  --color-success-subtle:   #dcfce7;\n  --color-success-text:     #14532d;\n\n  /* ─── Warning / Incomplete (Amber) ─── */\n  --color-warning:          #d97706;\n  --color-warning-hover:    #b45309;\n  --color-warning-subtle:   #fef3c7;\n  --color-warning-text:     #78350f;\n\n  /* ─── Danger / Error (Red) ─── */\n  --color-danger:           #dc2626;\n  --color-danger-hover:     #b91c1c;\n  --color-danger-subtle:    #fee2e2;\n  --color-danger-text:      #7f1d1d;\n\n  /* ─── Neutral / Secondary actions ─── */\n  --color-neutral:          #f1f5f9;\n  --color-neutral-hover:    #e2e8f0;\n  --color-neutral-text:     #0f172a;\n\n  /* ─── Calculating / Stale indicator (Purple) ─── */\n  --color-calc:             #7c3aed;\n  --color-calc-subtle:      #ede9fe;\n  --color-calc-text:        #4c1d95;\n\n  /* ─── Stale state (Slate) ─── */\n  --color-stale:            #475569;\n  --color-stale-subtle:     #f1f5f9;\n\n  /* ─── SVG / Canvas Element Colors ─── */\n  --color-member-default:   #334155;\n  --color-member-tension:   #1d4ed8;\n  --color-member-compression: #dc2626;\n  --color-member-zero:      #64748b;\n  --color-member-selected:  #d97706;\n  --color-joint-default:    #0f172a;\n  --color-joint-hover:      #0284c7;\n  --color-joint-selected:   #d97706;\n  --color-joint-member-start: #16a34a;\n  --color-support:          #0f172a;\n  --color-load-arrow:       #d97706;\n  --color-proposal-member:  #f59e0b;\n  --color-proposal-joint:   #d97706;\n  --color-opencv-line:      #06b6d4;\n  --color-grid-minor:       #e2e8f0;\n  --color-grid-major:       #cbd5e1;\n  --color-grid-axis:        #94a3b8;\n\n  /* ─── Spacing (8px base system) ─── */\n  --sp-0: 0px;\n  --sp-1: 4px;\n  --sp-2: 8px;\n  --sp-3: 12px;\n  --sp-4: 16px;\n  --sp-5: 20px;\n  --sp-6: 24px;\n  --sp-8: 32px;\n  --sp-10: 40px;\n\n  /* ─── Border Radius ─── */\n  --radius-sm: 4px;\n  --radius-md: 6px;\n  --radius-lg: 8px;\n  --radius-xl: 10px;\n  --radius-full: 9999px;\n\n  /* ─── Typography ─── */\n  --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  --font-mono: ui-monospace, 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;\n\n  --text-xs:   11px;\n  --text-sm:   12px;\n  --text-base: 13px;\n  --text-md:   14px;\n  --text-lg:   15px;\n\n  --weight-regular: 400;\n  --weight-medium:  500;\n  --weight-semibold: 600;\n  --weight-bold:    700;\n\n  /* ─── Shadows ─── */\n  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.04);\n  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);\n  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);\n  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.1);\n  --shadow-inset: inset 0 1px 2px rgba(0, 0, 0, 0.05);\n\n  /* ─── Transitions ─── */\n  --transition-fast: 0.1s ease;\n  --transition-base: 0.15s ease;\n  --transition-slow: 0.25s ease;\n\n  /* ─── Layout Constants ─── */\n  --topbar-height:   48px;\n  --statusbar-height: 36px;\n  --sidebar-width:   288px;\n  --ai-drawer-width: 340px;\n}\n\n:root {\n  font-family: 'Aptos', 'Segoe UI', Inter, ui-sans-serif, system-ui, sans-serif;\n  color: #252b2c;\n  background: #b5b9c2;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  --ink: #252b2c;\n  --muted: #788181;\n  --faint: #9da4a3;\n  --line: #e9e5d7;\n  --paper: #fffef8;\n  --canvas: #faf8ee;\n  --navy: #292b29;\n  --navy-deep: #202220;\n  --teal: #548477;\n  --teal-soft: #e8f1e8;\n  --amber: #d6bd52;\n  --amber-soft: #faf3d9;\n  --red: #b9574f;\n  --red-soft: #f8ecea;\n  --mono: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace;\n  --heading: 'Aptos Display', 'Segoe UI', Inter, ui-sans-serif, sans-serif;\n}\n\n* { box-sizing: border-box; }\n\n/* ─── Global Viewport: Zero Document/Browser-Level Scrollbars ─── */\nhtml,\nbody {\n  margin: 0;\n  padding: 0;\n  min-width: 360px;\n  height: 100vh;\n  height: 100dvh;\n  max-height: 100vh;\n  max-height: 100dvh;\n  overflow: hidden;\n  background: #b5b9c2;\n}\n\nbutton, input, select { font: inherit; }\nbutton { color: inherit; }\nbutton:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, [tabindex]:focus-visible { outline: 3px solid #83b8b1; outline-offset: 3px; }\n\n/* ─── Application Frame & Shell ─── */\n.app-frame {\n  width: min(1580px, calc(100% - 56px));\n  height: calc(100vh - 56px);\n  height: calc(100dvh - 56px);\n  max-height: calc(100vh - 56px);\n  max-height: calc(100dvh - 56px);\n  margin: 28px auto;\n  display: grid;\n  grid-template-columns: 225px minmax(0, 1fr);\n  overflow: hidden;\n  border: 1px solid #d3d1c4;\n  border-radius: 30px;\n  background: var(--canvas);\n  box-shadow: 0 30px 75px #292b3330, 0 3px 8px #292b3310;\n  box-sizing: border-box;\n}\n\n@media (max-width: 900px) {\n  .app-frame {\n    width: 100vw;\n    max-width: 100vw;\n    height: 100vh;\n    height: 100dvh;\n    max-height: 100vh;\n    max-height: 100dvh;\n    margin: 0;\n    border: none;\n    border-radius: 0;\n  }\n}\n\n/* ─── Sidebar (Fixed, stable, internal scroll if needed) ─── */\n.sidebar {\n  background: #fdfcf5;\n  border-right: 1px solid #e9e5d7;\n  height: 100%;\n  max-height: 100%;\n  overflow-y: auto;\n  overflow-x: hidden;\n  padding: 25px 15px 16px;\n  display: flex;\n  flex-direction: column;\n  box-sizing: border-box;\n  flex-shrink: 0;\n}\n\n.brand { display: flex; align-items: center; gap: 11px; color: var(--ink); text-decoration: none; padding: 0 8px; }\n.brand-mark { width: 38px; height: 38px; border-radius: 13px; color: #f7f3df; background: var(--navy); display: grid; place-items: center; overflow: hidden; }\n.brand-mark svg { width: 26px; height: 26px; }\n.brand-copy { display: flex; flex-direction: column; gap: 2px; }\n.brand-copy strong { font-family: var(--heading); font-weight: 800; font-size: 16px; letter-spacing: -.55px; }\n.brand-copy small { font-family: var(--mono); color: #83908d; font-size: 8px; letter-spacing: 1.25px; }\n\n.local-banner { margin: 25px 8px 22px; border: 1px solid #e9e5d7; background: #f8f6e9; color: #77796d; border-radius: 999px; padding: 8px 10px; display: flex; align-items: center; gap: 8px; text-transform: uppercase; font: 8px var(--mono); letter-spacing: .7px; }\n.local-dot, .backend-indicator { width: 7px; height: 7px; border-radius: 50%; background: #4e9c7d; box-shadow: 0 0 0 3px #e4f0e9; }\n\n.primary-nav { display: flex; flex-direction: column; gap: 5px; }\n.nav-item { border: 0; background: transparent; color: #73766f; min-height: 40px; border-radius: 999px; text-align: left; display: flex; align-items: center; gap: 10px; padding: 0 11px; font-size: 11px; font-weight: 650; cursor: pointer; transition: background 0.15s ease, color 0.15s ease; }\n.nav-item:hover { background: #f4f2e8; color: var(--ink); }\n.nav-item.active { color: #30312d; background: #f2dc70; }\n.nav-item svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }\n.nav-count { margin-left: auto; font: 10px var(--mono); color: #85918f; background: #fff; border: 1px solid #e4e8e5; min-width: 21px; height: 21px; border-radius: 6px; display: grid; place-items: center; }\n\n.sidebar-section { margin-top: 34px; }\n.section-label { color: #97a09e; font: 9px var(--mono); letter-spacing: 1.1px; padding: 0 9px 9px; display: flex; justify-content: space-between; align-items: center; }\n.section-label button { width: 22px; height: 22px; border: 0; background: transparent; font-size: 18px; color: #7f8a87; cursor: pointer; border-radius: 5px; }\n.section-label button:hover { background: #edf2ee; }\n.side-state { color: #899390; font-size: 11px; line-height: 1.5; padding: 11px 10px; }\n.side-error { color: var(--red); }\n\n.recent-item { width: 100%; border: 0; background: transparent; text-align: left; display: flex; align-items: flex-start; gap: 10px; padding: 10px 9px; border-radius: 7px; cursor: pointer; }\n.recent-item:hover, .recent-item.selected { background: #f0f4f1; }\n.recent-status { flex: 0 0 7px; width: 7px; height: 7px; border-radius: 50%; margin-top: 5px; }\n.recent-copy { min-width: 0; display: flex; flex-direction: column; gap: 4px; }\n.recent-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; font-weight: 600; color: #4b5654; }\n.recent-copy small { font: 9px var(--mono); color: #9aa3a0; }\n\n.sidebar-spacer { flex: 1; min-height: 24px; }\n\n.sidebar-guide-card {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 12px 10px;\n  border: 1px solid #e5eae6;\n  border-radius: 10px;\n  background: #f7f9f6;\n  color: #66726e;\n  margin-bottom: 8px;\n}\n.guide-card-icon { font-size: 16px; flex-shrink: 0; }\n.guide-card-copy strong { display: block; color: #52615b; font-size: 11px; margin-bottom: 2px; }\n.guide-card-copy p { font-size: 9px; line-height: 1.45; margin: 0 0 6px; color: #83908b; }\n.btn-guide-start { border: none; background: transparent; color: #0284c7; font-size: 10px; font-weight: 700; cursor: pointer; padding: 0; }\n.btn-guide-start:hover { text-decoration: underline; }\n\n.sidebar-footer { display: flex; align-items: center; gap: 8px; padding: 12px 9px 3px; color: #929b99; font: 9px var(--mono); flex-shrink: 0; }\n\n/* ─── Main Content Area (Fixed layout, stable topbar) ─── */\n.main-area {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  max-height: 100%;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  background: #faf8ee;\n  position: relative;\n}\n\n.topbar {\n  height: 59px;\n  flex: 0 0 59px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid #e9e5d7;\n  padding: 0 clamp(22px, 3vw, 44px);\n  background: #fffef8;\n  z-index: 10;\n  flex-shrink: 0;\n}\n\n.breadcrumb { display: flex; align-items: center; gap: 11px; font-size: 11px; color: #8c9693; }\n.breadcrumb strong { color: #47514f; font-weight: 600; }\n.crumb-separator { color: #c0c8c4; }\n\n.topbar-right { display: flex; gap: 12px; align-items: center; }\n.local-pill { padding: 6px 9px; border: 1px solid #e9e5d7; border-radius: 999px; color: #73786d; font: 8px var(--mono); letter-spacing: .65px; display: flex; align-items: center; gap: 6px; }\n.local-pill span { width: 5px; height: 5px; border-radius: 50%; background: #6da787; }\n\n/* ─── Main Content Viewport (Handles internal vertical scrolling) ─── */\n.main-content-viewport {\n  flex: 1 1 auto;\n  min-height: 0;\n  min-width: 0;\n  height: calc(100% - 59px);\n  overflow-y: auto;\n  overflow-x: hidden;\n  overscroll-behavior: contain;\n  scroll-behavior: smooth;\n  display: flex;\n  flex-direction: column;\n}\n\n.main-content-viewport::-webkit-scrollbar {\n  width: 7px;\n}\n.main-content-viewport::-webkit-scrollbar-track {\n  background: transparent;\n}\n.main-content-viewport::-webkit-scrollbar-thumb {\n  background: #d6d3c7;\n  border-radius: 4px;\n}\n.main-content-viewport::-webkit-scrollbar-thumb:hover {\n  background: #b8b4a6;\n}\n\n.page-content {\n  width: min(100%, 1470px);\n  margin: 0 auto;\n  padding: 37px clamp(22px, 3vw, 44px) 45px;\n  flex: 1 0 auto;\n  min-width: 0;\n  box-sizing: border-box;\n}\n\n.main-footer {\n  flex-shrink: 0;\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  color: #a1aaa5;\n  padding: 14px clamp(22px, 4vw, 56px) 20px;\n  border-top: 1px solid #e5e9e5;\n  font: 8px var(--mono);\n  background: transparent;\n}\n\n/* ─── Editor-Specific Viewport Layout (Matches Reference Fix) ─── */\n.app-frame.in-editor-frame {\n  width: 100vw !important;\n  max-width: 100vw !important;\n  height: 100vh !important;\n  height: 100dvh !important;\n  max-height: 100vh !important;\n  max-height: 100dvh !important;\n  margin: 0 !important;\n  border: none !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n  overflow: hidden !important;\n  display: grid !important;\n  grid-template-columns: 225px minmax(0, 1fr) !important;\n}\n\n.app-frame.in-editor-frame .sidebar {\n  height: 100% !important;\n  max-height: 100vh !important;\n  max-height: 100dvh !important;\n  overflow-y: auto !important;\n  overflow-x: hidden !important;\n  padding: 18px 14px 14px !important;\n  box-sizing: border-box !important;\n}\n\n.main-area.in-editor {\n  height: 100% !important;\n  max-height: 100vh !important;\n  max-height: 100dvh !important;\n  min-height: 0 !important;\n  min-width: 0 !important;\n  overflow: hidden !important;\n  display: flex !important;\n  flex-direction: column !important;\n}\n\n/* ─── Transitions and Micro-interactions ─── */\n.nav-item,\n.button,\n.dashboard-primary,\n.dashboard-ai-btn,\n.dashboard-link,\n.overview-card,\n.recent-analysis-card,\n.analysis-card {\n  transition: transform 0.15s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;\n}\n\n.button:not(:disabled):active,\n.dashboard-primary:active,\n.dashboard-ai-btn:active {\n  transform: scale(0.98);\n}\n\n.recent-analysis-card:hover,\n.analysis-card:hover {\n  transform: translateY(-2px);\n}\n\n.view-fade-enter-active,\n.view-fade-leave-active {\n  transition: opacity 0.15s ease, transform 0.15s ease;\n}\n\n.view-fade-enter-from {\n  opacity: 0;\n  transform: translateY(4px);\n}\n\n.view-fade-leave-to {\n  opacity: 0;\n  transform: translateY(-4px);\n}\n\n@keyframes modal-pop {\n  from {\n    opacity: 0;\n    transform: scale(0.96) translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n.modal-animate {\n  animation: modal-pop 0.18s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n.page-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin: 3px 0 30px; }\n.eyebrow { color: #8c9691; font: 9px var(--mono); letter-spacing: 1.35px; margin-bottom: 9px; text-transform: uppercase; }\nh1, h2, h3, p { margin-top: 0; }\nh1 { font: 700 clamp(27px, 3vw, 39px)/1.15 var(--heading); letter-spacing: -1.35px; color: #273331; margin-bottom: 10px; }\nh1 em { color: #388780; font-style: normal; }\n.page-heading p { max-width: 680px; color: #7b8582; font-size: 13px; line-height: 1.65; margin-bottom: 0; }\n.heading-stamp { display: flex; align-items: center; gap: 9px; color: #9aa39f; font: 9px var(--mono); letter-spacing: 1px; white-space: nowrap; padding-bottom: 4px; }\n.stamp-line { display: block; width: 28px; height: 1px; background: #c8d1cc; }\n.card-surface { background: var(--paper); border: 1px solid #e3e8e4; border-radius: 10px; box-shadow: 0 2px 6px rgba(31, 55, 44, .025); }\n.intake-grid { display: grid; grid-template-columns: minmax(0, 1.07fr) minmax(360px, .93fr); gap: 17px; }\n.upload-card, .workflow-card { padding: 23px; }\n.card-heading { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; }\n.card-heading .eyebrow { margin-bottom: 6px; }\nh2 { font: 700 17px/1.3 var(--heading); letter-spacing: -.35px; color: #303a38; margin: 0; }\n.file-limit { color: #929c98; font: 9px var(--mono); padding: 6px 7px; border: 1px solid #e8ece9; border-radius: 5px; }\n.dropzone { min-height: 174px; border: 1px dashed #c4d2cc; border-radius: 8px; background: #f8faf8; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px; cursor: pointer; transition: border-color .15s, background .15s; text-align: center; padding: 18px; }\n.dropzone:hover, .dropzone.dragging { border-color: #4e9389; background: #f0f7f4; }\n.dropzone.has-file { border-style: solid; border-color: #8bb8a8; background: #f4f9f5; }\n.upload-icon { width: 34px; height: 34px; border: 1px solid #dce8e2; border-radius: 9px; display: grid; place-items: center; color: #488d83; background: #fff; margin-bottom: 3px; }\n.upload-icon svg { width: 18px; height: 18px; }\n.dropzone strong { font-size: 12px; font-weight: 700; color: #43504c; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.dropzone span { color: #83908a; font-size: 10px; }\n.dropzone u { color: #397e76; text-underline-offset: 2px; }\n.dropzone small { color: #a1aaa6; font: 9px var(--mono); margin-top: 4px; }\n.upload-preview { display: grid; grid-template-columns: 54px 1fr auto; gap: 9px; align-items: center; margin-top: 10px; padding: 7px; border: 1px solid #e4e9e4; border-radius: 6px; color: #7f8b85; font-size: 9px; }\n.upload-preview img { width: 54px; height: 40px; border-radius: 3px; object-fit: contain; background: #eef0ec; }\n.upload-preview button { border: 0; background: transparent; color: #9b6258; cursor: pointer; font-size: 9px; }\n.heading-actions { display: flex; align-items: center; gap: 12px; }\n.upload-options { display: flex; justify-content: space-between; align-items: center; margin: 18px 0 12px; }\n.upload-options label { color: #68736f; font-size: 11px; font-weight: 600; }\n.upload-options select { width: 190px; border: 1px solid #dfe6e1; border-radius: 6px; padding: 8px 10px; color: #485650; background: #fff; font-size: 10px; }\n.button { border: 1px solid transparent; border-radius: 6px; min-height: 37px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; font-size: 11px; font-weight: 700; cursor: pointer; transition: background .15s, border-color .15s, transform .15s; }\n.button:disabled { opacity: .5; cursor: not-allowed; transform: none; }\n.button:not(:disabled):active { transform: translateY(1px); }\n.button-primary { background: var(--navy); color: #fff; }\n.button-primary:not(:disabled):hover { background: #1d5559; }\n.button-secondary { background: #fff; color: #54615d; border-color: #dfe5e1; }\n.button-secondary:hover { border-color: #aebdb6; background: #f8faf8; }\n.button svg { width: 15px; height: 15px; }\n.upload-submit { width: 100%; min-height: 41px; justify-content: space-between; padding: 0 13px; }\n.upload-submit svg { margin-left: auto; }\n.button-spinner, .large-spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.35); border-top-color: white; border-radius: 50%; animation: spin .75s linear infinite; }\n.credential-note { display: flex; justify-content: center; align-items: center; gap: 6px; color: #98a19d; font-size: 9px; margin: 12px 0 0; }\n.credential-note svg { width: 12px; height: 12px; }\n.workflow-icon { color: #498e83; font-size: 25px; line-height: 1; }\n.workflow-step { display: grid; grid-template-columns: 27px minmax(0, 1fr) auto; gap: 12px; padding: 14px 0; border-top: 1px solid #edf0ed; align-items: start; }\n.step-number { color: #a1aaa6; font: 10px var(--mono); padding-top: 2px; }\n.workflow-step strong { display: block; color: #3e4945; font-size: 11px; margin-bottom: 4px; }\n.workflow-step p { color: #828d88; font-size: 10px; line-height: 1.55; margin: 0; max-width: 390px; }\n.step-tag { font: 8px var(--mono); letter-spacing: .7px; border-radius: 4px; padding: 4px 5px; margin-top: 0; }\n.tag-vision { color: #327d79; background: #e7f4f2; }\n.tag-ai { color: #9a6b38; background: #f7f0e6; }\n.tag-review { color: #67766f; background: #eef1ec; }\n.workflow-note { display: flex; gap: 8px; align-items: flex-start; padding: 10px 11px; margin-top: 4px; background: #f7f7f