nd: transparent; font-size: 14px; color: #52564c; cursor: pointer; padding: 2px 6px;\n}\n.workbench-input-row[data-v-ec0fe1c5] { display: flex; gap: 8px; align-items: center;\n}\n.workbench-input[data-v-ec0fe1c5] { flex: 1; min-height: 38px; padding: 0 14px; border: 1px solid #dcd7c9; border-radius: 8px; font-size: 12px; font-family: inherit; color: #292a28; outline: none; background: #fff;\n}\n.workbench-input[data-v-ec0fe1c5]:focus { border-color: #0284c7; box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15);\n}\n.workbench-submit-btn[data-v-ec0fe1c5] { min-height: 38px; display: inline-flex; align-items: center; gap: 6px; padding: 0 16px; border-radius: 8px; border: 1px solid #292a28; background: #292a28; color: #fff; font-size: 11px; font-weight: 700; cursor: pointer; transition: background 0.15s ease; white-space: nowrap;\n}\n.workbench-submit-btn[data-v-ec0fe1c5]:hover:not(:disabled) { background: #42453e;\n}\n.workbench-submit-btn[data-v-ec0fe1c5]:disabled { opacity: 0.5; cursor: not-allowed;\n}\n.workbench-chips[data-v-ec0fe1c5] { display: flex; align-items: center; gap: 6px; flex-wrap: wrap;\n}\n.chips-label[data-v-ec0fe1c5] { font: 700 9px var(--mono, monospace); color: #8c8f82; text-transform: uppercase;\n}\n.workbench-chip[data-v-ec0fe1c5] { background: #fff; border: 1px solid #e2ddd0; border-radius: 999px; padding: 3px 10px; font-size: 10px; color: #5a5d53; cursor: pointer; transition: all 0.15s ease;\n}\n.workbench-chip[data-v-ec0fe1c5]:hover:not(:disabled) { background: #fdf8e6; border-color: #d4caa8; color: #292a28;\n}\n.workbench-error[data-v-ec0fe1c5] { background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 8px 12px; font-size: 11px; color: #991b1b;\n}\n.workbench-proposal-wrapper[data-v-ec0fe1c5] { margin-top: 4px;\n}\n.empty-actions[data-v-ec0fe1c5] { display: flex; align-items: center; gap: 10px;\n}\n.dashboard-secondary-empty[data-v-ec0fe1c5] { min-height: 38px; display: inline-flex; align-items: center; gap: 6px; border: 1px sol