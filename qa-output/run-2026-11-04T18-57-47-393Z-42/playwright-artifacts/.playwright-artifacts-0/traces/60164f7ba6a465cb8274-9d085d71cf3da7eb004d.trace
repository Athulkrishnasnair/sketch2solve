 3px;\n  border-radius: 2px;\n}\n.legend-swatch.normal[data-v-0ea7f51c] { background: #292a28;\n}\n.legend-swatch.added[data-v-0ea7f51c] { background: #0284c7; border-top: 1px dashed #0284c7;\n}\n.legend-swatch.removal[data-v-0ea7f51c] { background: #ef4444;\n}\n.legend-swatch.support[data-v-0ea7f51c] { width: 8px; height: 8px; background: #606859; border-radius: 1px;\n}\n.canvas-loading[data-v-0ea7f51c], .canvas-empty[data-v-0ea7f51c] {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  color: #8b8e82;\n  font-size: 12px;\n}\n.canvas-empty p[data-v-0ea7f51c] {\n  margin: 0;\n  max-width: 320px;\n  text-align: center;\n  font-size: 11px;\n}\n.empty-icon[data-v-0ea7f51c] {\n  color: #c0bcae;\n}\n.spin-icon[data-v-0ea7f51c] {\n  animation: spin 1s linear infinite;\n}\n"],["STYLE",{},"\n.cdialog-backdrop[data-v-d3e333dd] {\n  position: fixed;\n  inset: 0;\n  z-index: 9000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(15, 23, 42, 0.4);\n  backdrop-filter: blur(2px);\n}\n.cdialog-panel[data-v-d3e333dd] {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-lg);\n  padding: var(--sp-6);\n  min-width: 320px;\n  max-width: 440px;\n  width: 90%;\n}\n.cdialog-title[data-v-d3e333dd] {\n  font-size: var(--text-md);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text-primary);\n  margin: 0 0 var(--sp-2);\n}\n.cdialog-message[data-v-d3e333dd] {\n  font-size: var(--text-base);\n  color: var(--color-text-secondary);\n  line-height: 1.55;\n  margin: 0 0 var(--sp-5);\n}\n.cdialog-actions[data-v-d3e333dd] {\n  display: flex;\n  gap: var(--sp-2);\n  justify-content: flex-end;\n}\n.cdialog-btn[data-v-d3e333dd] {\n  display: inline-flex;\n  align-items: center;\n  padding: 6px 16px;\n  font-size: var(--text-base);\n  font-weight: var(--weight-medium);\n  border-radius: var(--rad