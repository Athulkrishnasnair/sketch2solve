: 1;\n}\n.btn-new-analysis[data-v-ec0fe1c5] { /* Semantic handle for header action */\n}\n.btn-empty-start[data-v-ec0fe1c5] { /* Semantic handle for empty state action */\n}\n.dashboard-ai-btn[data-v-ec0fe1c5] { min-height: 38px; display: inline-flex; align-items: center; gap: 7px; border: 1px solid #0284c7; border-radius: 999px; padding: 0 16px; color: #0284c7; background: #f0f9ff; font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.15s ease;\n}\n.dashboard-ai-btn[data-v-ec0fe1c5]:hover { background: #e0f2fe; color: #0369a1;\n}\n.dashboard-ai-btn.active[data-v-ec0fe1c5] { background: #0284c7; color: #fff;\n}\n.dashboard-guide-btn[data-v-ec0fe1c5] { min-height: 38px; display: inline-flex; align-items: center; gap: 7px; border: 1px solid #cbd5e1; border-radius: 999px; padding: 0 16px; color: #334155; background: #fff; font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.15s ease;\n}\n.dashboard-guide-btn[data-v-ec0fe1c5]:hover { background: #f1f5f9; color: #0f172a; border-color: #94a3b8;\n}\n.dashboard-link[data-v-ec0fe1c5] { border: 0; padding: 7px 0; color: #575b52; background: none; font-size: 10px; font-weight: 700; cursor: pointer;\n}\n\n/* In-place AI Workbench */\n.dashboard-ai-workbench[data-v-ec0fe1c5] {\n  margin-top: 14px;\n  background: #fffdf9;\n  border: 1px solid #ecd897;\n  border-radius: 16px;\n  padding: 16px 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  box-shadow: 0 4px 18px rgba(180, 140, 20, 0.08);\n}\n.workbench-header[data-v-ec0fe1c5] { display: flex; align-items: center; justify-content: space-between;\n}\n.workbench-title[data-v-ec0fe1c5] { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #292a28;\n}\n.sparkle-icon[data-v-ec0fe1c5] { color: #d97706;\n}\n.workbench-badge[data-v-ec0fe1c5] { font: 700 9px var(--mono, monospace); background: #fef3c7; color: #b45309; padding: 2px 7px; border-radius: 4px;\n}\n.btn-close-workbench[data-v-ec0fe1c5] { border: none; background: transparent; font-size: 14px; color: #52564c; cursor: pointer; padding: 2px 6px;\n}\n.workbench-input-row[data-v-ec0fe1c5] { display: flex; gap: 8px; align-items: center;\n}\n.workbench-input[data-v-ec0fe1c5] { flex: 1; min-height: 38px; padding: 0 14px; border: 1px solid #dcd7c9; border-radius: 8px; font-size: 12px; font-family: inherit; color: #292a28; outline: none; background: #fff;\n}\n.workbench-input[data-v-ec0fe1c5]:focus { border-color: #0284c7; box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15);\n}\n.workbench-submit-btn[data-v-ec0fe1c5] { min-height: 38px; display: inline-flex; align-items: center; gap: 6px; padding: 0 16px; border-radius: 8px; border: 1px solid #292a28; background: #292a28; color: #fff; font-size: 11px; font-weight: 700; cursor: pointer; transition: background 0.15s ease; white-space: nowrap;\n}\n.workbench-submit-btn[data-v-ec0fe1c5]:hover:not(:disabled) { background: #42453e;\n}\n.workbench-submit-btn[data-v-ec0fe1c5]:disabled { opacity: 0.5; cursor: not-allowed;\n}\n.workbench-chips[data-v-ec0fe1c5] { display: flex; align-items: center; gap: 6px; flex-wrap: wrap;\n}\n.chips-label[data-v-ec0fe1c5] { font: 700 9px var(--mono, monospace); color: #8c8f82; text-transform: uppercase;\n}\n.workbench-chip[data-v-ec0fe1c5] { background: #fff; border: 1px solid #e2ddd0; border-radius: 999px; padding: 3px 10px; font-size: 10px; color: #5a5d53; cursor: pointer; transition: all 0.15s ease;\n}\n.workbench-chip[data-v-ec0fe1c5]:hover:not(:disabled) { background: #fdf8e6; border-color: #d4caa8; color: #292a28;\n}\n.workbench-error[data-v-ec0fe1c5] { background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 8px 12px; font-size: 11px; color: #991b1b;\n}\n.workbench-proposal-wrapper[data-v-ec0fe1c5] { margin-top: 4px;\n}\n.empty-actions[data-v-ec0fe1c5] { display: flex; align-items: center; gap: 10px;\n}\n.dashboard-secondary-empty[data-v-ec0fe1c5] { min-height: 38px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #0284c7; border-radius: 999px; padding: 0 14px; color: #0284c7; background: #f0f9ff; font-size: 11px; font-weight: 700; cursor: pointer;\n}\n.spin-icon[data-v-ec0fe1c5] { animation: spin-ec0fe1c5 1s linear infinite;\n}\n@keyframes spin-ec0fe1c5 {\n100% { transform: rotate(360deg);\n}\n}\n.dashboard-link span[data-v-ec0fe1c5] { padding-left: 5px; font-size: 13px;\n}\n.welcome-mark[data-v-ec0fe1c5] { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; padding: 0 8px; color: #747d6b;\n}\n.welcome-mark svg[data-v-ec0fe1c5] { width: min(100%, 290px); max-height: 150px; stroke: #a7a984; stroke-width: 1.4;\n}\n.welcome-mark circle[data-v-ec0fe1c5] { fill: #f4dc68; stroke: #8e9879; stroke-width: 1.4;\n}\n.welcome-mark span[data-v-ec0fe1c5] { margin: 6px 4px 0 0; color: #a09c7a; font: 8px var(--mono); letter-spacing: 1px;\n}\n.dashboard-overview[data-v-ec0fe1c5] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 14px 0 31px;\n}\n.overview-card[data-v-ec0fe1c5] { min-height: 75px; display: flex; align-items: center; gap: 11px; padding: 12px 14px; border: 1px solid #eae7dc; border-radius: 14px; background: #fffef9; box-shadow: 0 3px 9px #3b362508;\n}\n.overview-icon[data-v-ec0fe1c5] { width: 31px; height: 31px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 10px; color: #707568; background: #f1f0e7; font-size: 17px;\n}\n.overview-card > div[data-v-ec0fe1c5] { min-width: 0; display: flex; flex-direction: column; gap: 4px;\n}\n.overview-card small[data-v-ec0fe1c5] { color: #9b9b8d; font: 8px var(--mono); text-transform: uppercase; letter-spacing: .55px;\n}\n.overview-card strong[data-v-ec0fe1c5] { overflow: hidden; color: #343731; font: 600 13px var(--heading); text-overflow: ellipsis; white-space: nowrap;\n}\n.overview-note[data-v-ec0fe1c5] { margin-left: auto; color: #9a9b8e; font-size: 8px; text-align: right;\n}\n.review-icon[data-v-ec0fe1c5] { color: #437768; background: #e8f1e8;\n}\n.solver-card[data-v-ec0fe1c5] { color: #fff9e8; background: #2a2b29; border-color: #2a2b29;\n}\n.solver-card .solver-icon[data-v-ec0fe1c5] { color: #e8d16e; background: #41413a;\n}\n.solver-card small[data-v-ec0fe1c5] { color: #b8b6a6;\n}\n.solver-card strong[data-v-ec0fe1c5] { color: #fff9e7;\n}\n.solver-card .overview-note[data-v-ec0fe1c5] { color: #c1bd9d;\n}\n.failure-card[data-v-ec0fe1c5] { background: #2a2b29; border-color: #2a2b29;\n}\n.failure-card .failure-icon[data-v-ec0fe1c5] { color: #f1d36f; background: #41413a;\n}\n.failure-card small[data-v-ec0fe1c5] { color: #b8b6a6;\n}\n.failure-card strong[data-v-ec0fe1c5] { color: #fff9e7;\n}\n.failure-card button[data-v-ec0fe1c5] { width: 26px; height: 26px; margin-left: auto; border: 1px solid #55564f; border-radius: 50%; color: #f8e7a3; background: transparent; cursor: pointer;\n}\n.recent-work-section[data-v-ec0fe1c5] { margin-top: 6px;\n}\n.recent-work-heading[data-v-ec0fe1c5] { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 13px;\n}\n.recent-work-heading .eyebrow[data-v-ec0fe1c5] { margin-bottom: 5px;\n}\n.recent-work-heading h2[data-v-ec0fe1c5] { color: #30332e; font: 650 19px var(--heading); letter-spacing: -.5px;\n}\n.recent-work-heading h2 span[data-v-ec0fe1c5] { display: inline-grid; min-width: 22px; height: 22px; margin-left: 5px; place-items: center; vertical-align: 2px; border-radius: 50%; color: #777968; background: #eeeddf; font: 9px var(--mono);\n}\n.dashboard-state[data-v-ec0fe1c5], .dashboard-empty[data-v-ec0fe1c5] { min-height: 145px; display: flex; align-items: center; justify-content: center; gap: 20px; padding: 23px; border: 1px dashed #dedccc; border-radius: 17px; color: #858477; background: #fffef7a8;\n}\n.dashboard-state[data-v-ec0fe1c5] { flex-direction: column; gap: 4px;\n}\n.dashboard-state p[data-v-ec0fe1c5], .dashboard-empty p[data-v-ec0fe1c5] { margin: 5px 0 0; color: #939285; font-size: 10px;\n}\n.dashboard-state strong[data-v-ec0fe1c5], .dashboard-empty strong[data-v-ec0fe1c5] { color: #4e5048; font: 650 13px var(--heading);\n}\n.dashboard-error[data-v-ec0fe1c5] { border-color: #ead0c8; color: #a3554d;\n}\n.dashboard-error p[data-v-ec0fe1c5] { max-width: 540px;\n}\n.dashboard-error button[data-v-ec0fe1c5] { margin-top: 7px; border: 0; color: #81564d; background: transparent; font-weight: 700; cursor: pointer;\n}\n.empty-sketch[data-v-ec0fe1c5] { width: 95px; flex: 0 0 auto;\n}\n.empty-sketch svg[data-v-ec0fe1c5] { width: 100%; stroke: #9ba58c; stroke-width: 1.4;\n}\n.empty-sketch circle[data-v-ec0fe1c5] { fill: #f1d86e; stroke: #87917b;\n}\n.dashboard-empty > div[data-v-ec0fe1c5]:nth-child(2) { flex: 1;\n}\n.recent-analysis-grid[data-v-ec0fe1c5] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; gap: 12px;\n}\n.recent-analysis-card[data-v-ec0fe1c5] { min-width: 0; display: flex; flex-direction: column; overflow: hidden; padding: 0; border: 1px solid #e8e5d9; border-radius: 15px; color: inherit; background: #fffef9; box-shadow: 0 3px 10px #3b362508; text-align: left; cursor: pointer; transition: transform .16s ease, box-shadow .16s ease;\n}\n.recent-analysis-card[data-v-ec0fe1c5]:hover { transform: translateY(-2px); box-shadow: 0 8px 18px #3b362511;\n}\n.analysis-thumb[data-v-ec0fe1c5] { height: 126px; position: relative; display: grid; place-items: center; overflow: hidden; background: #e8e7de;\n}\n.analysis-thumb img[data-v-ec0fe1c5] { width: 100%; height: 100%; padding: 6px; object-fit: contain;\n}\n.thumb-index[data-v-ec0fe1c5] { position: absolute; top: 9px; left: 9px; padding: 5px 7px; border: 1px solid #ffffffa3; border-radius: 99px; color: #45483f; background: #fffef0d9; font: 8px var(--mono);\n}\n.thumb-placeholder[data-v-ec0fe1c5] { width: 94px; opacity: .68;\n}\n.thumb-placeholder svg[data-v-ec0fe1c5] { width: 100%; stroke: #7a8779; stroke-width: 1.5;\n}\n.thumb-placeholder circle[data-v-ec0fe1c5] { fill: #e5cf67; stroke: #8