rder-radius: 17px; color: #858477; background: #fffef7a8;\n}\n.dashboard-state[data-v-ec0fe1c5] { flex-direction: column; gap: 4px;\n}\n.dashboard-state p[data-v-ec0fe1c5], .dashboard-empty p[data-v-ec0fe1c5] { margin: 5px 0 0; color: #939285; font-size: 10px;\n}\n.dashboard-state strong[data-v-ec0fe1c5], .dashboard-empty strong[data-v-ec0fe1c5] { color: #4e5048; font: 650 13px var(--heading);\n}\n.dashboard-error[data-v-ec0fe1c5] { border-color: #ead0c8; color: #a3554d;\n}\n.dashboard-error p[data-v-ec0fe1c5] { max-width: 540px;\n}\n.dashboard-error button[data-v-ec0fe1c5] { margin-top: 7px; border: 0; color: #81564d; background: transparent; font-weight: 700; cursor: pointer;\n}\n.empty-sketch[data-v-ec0fe1c5] { width: 95px; flex: 0 0 auto;\n}\n.empty-sketch svg[data-v-ec0fe1c5] { width: 100%; stroke: #9ba58c; stroke-width: 1.4;\n}\n.empty-sketch circle[data-v-ec0fe1c5] { fill: #f1d86e; stroke: #87917b;\n}\n.dashboard-empty > div[data-v-ec0fe1c5]:nth-child(2) { flex: 1;\n}\n.recent-analysis-grid[data-v-ec0fe1c5] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; gap: 12px;\n}\n.recent-analysis-card[data-v-ec0fe1c5] { min-width: 0; display: flex; flex-direction: column; overflow: hidden; padding: 0; border: 1px solid #e8e5d9; border-radius: 15px; color: inherit; background: #fffef9; box-shadow: 0 3px 10px #3b362508; text-align: left; cursor: pointer; transition: transform .16s ease, box-shadow .16s ease;\n}\n.recent-analysis-card[data-v-ec0fe1c5]:hover { transform: translateY(-2px); box-shadow: 0 8px 18px #3b362511;\n}\n.analysis-thumb[data-v-ec0fe1c5] { height: 126px; position: relative; display: grid; place-items: center; overflow: hidden; background: #e8e7de;\n}\n.analysis-thumb img[data-v-ec0fe1c5] { width: 100%; height: 100%; padding: 6px; object-fit: contain;\n}\n.thumb-index[data-v-ec0fe1c5] { position: absolute; top: 9px; left: 9px; padding: 5px 7px; border: 1px solid #ffffffa3; border-radius: 99px; color: #45483f; background: #fffef0d9; font: 8px var(--mono);\n}\n.thumb-placeholder[data-v-ec0fe1c5] { width: 94px; opacity: .68;\n}\n.thumb-placeholder svg[data-v-ec0fe1c5] { width: 100%; stroke: #7a8779; stroke-width: 1.5;\n}\n.thumb-placeholder circle[data-v-ec0fe1c5] { fill: #e5cf67; stroke: #818879;\n}\n.analysis-card-details[data-v-ec0fe1c5] { display: flex; flex-direction: column; gap: 9px; padding: 11px 13px 12px;\n}\n.analysis-card-topline[data-v-ec0fe1c5], .analysis-card-meta[data-v-ec0fe1c5] { display: flex; align-items: center; justify-content: space-between; gap: 8px;\n}\n.dashboard-status[data-v-ec0fe1c5] { display: inline-flex; align-items: center; gap: 5px; padding: 4px 7px; border-radius: 99px; font: 8px var(--mono);\n}\n.dashboard-status i[data-v-ec0fe1c5] { width: 5px; height: 5px; border-radius: 50%; background: currentColor;\n}\n.dashboard-status.pending[data-v-ec0fe1c5] { color: #907832; background: #f7f0d4;\n}\n.dashboard-status.complete[data-v-ec0fe1c5] { color: #467763; background: #e8f1e8;\n}\n.dashboard-status.failed[data-v-ec0fe1c5] { color: #9c514a; background: #f7eae3;\n}\n.dashboard-arrow[data-v-ec0fe1c5] { color: #61645a; font-size: 13px;\n}\n.analysis-card-details > strong[data-v-ec0fe1c5] { overflow: hidden; color: #393c36; font: 650 11px var(--heading); text-overflow: ellipsis; white-space: nowrap;\n}\n.analysis-card-meta[data-v-ec0fe1c5] { color: #5a6058; font: 8px var(--mono); text-transform: capitalize;\n}\n.analysis-failure-message[data-v-ec0fe1c5] { overflow: hidden; color: #a76157; font-size: 8px; text-overflow: ellipsis; white-space: nowrap;\n}\n@media (max-width: 1050px) {\n.dashboard-overview[data-v-ec0fe1c5] { grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n.recent-analysis-grid[data-v-ec0fe1c5] { grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n}\n@media (max-width: 640px) {\n.dashboard-page[data-v-ec0fe1c5] { padding-top: 21px;\n}\n.dashboard-welcome[data-v-ec0fe1c5] { min-height: auto; grid-template-columns: 1fr; padding: 24px