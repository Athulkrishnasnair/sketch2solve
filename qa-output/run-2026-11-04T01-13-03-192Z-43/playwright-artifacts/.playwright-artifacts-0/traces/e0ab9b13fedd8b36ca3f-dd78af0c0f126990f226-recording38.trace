 14px; }\n.empty-panel { min-height: 160px; border: 1px dashed #d5ddd7; background: rgba(255,255,255,.6); border-radius: 9px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; color: #85908b; }\n.empty-panel > strong { color: #58645f; font: 700 13px var(--heading); margin: 10px 0 5px; }\n.empty-panel p { color: #8c9691; font-size: 10px; margin: 0 0 12px; }\n.empty-drawing { width: 60px; height: 37px; position: relative; margin-bottom: 4px; }\n.empty-drawing span { position: absolute; height: 1px; width: 34px; background: #a9bdb2; transform-origin: left; left: 10px; top: 26px; }\n.empty-drawing span:nth-child(1) { transform: rotate(-55deg); width: 24px; }\n.empty-drawing span:nth-child(2) { left: 24px; top: 6px; transform: rotate(55deg); width: 24px; }\n.empty-drawing span:nth-child(3) { left: 10px; top: 26px; width: 38px; }\n.empty-drawing i { position: absolute; left: 21px; top: 4px; width: 6px; height: 6px; border-radius: 50%; background: #5e9882; box-shadow: -12px 23px 0 #5e9882, 26px 23px 0 #5e9882; }\n.error-empty { border-color: #e9c8c4; }\n.loading-dots { letter-spacing: 4px; color: #47877f; font-size: 19px; animation: breathe 1.1s ease-in-out infinite alternate; }\n.analysis-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.analysis-card { border: 1px solid #e2e8e3; background: #fff; min-height: 109px; border-radius: 8px; padding: 13px 14px; text-align: left; display: flex; flex-direction: column; cursor: pointer; transition: border-color .15s, box-shadow .15s; }\n.analysis-card:hover { border-color: #b7ccc2; box-shadow: 0 5px 14px rgba(36, 66, 52, .06); }\n.analysis-card-top, .analysis-card-bottom { display: flex; justify-content: space-between; align-items: center; gap: 10px; }\n.analysis-card > strong { font-size: 11px; color: #47524e; font-weight: 700; margin: 11px 0 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.status-ba