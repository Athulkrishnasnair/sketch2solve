d var(--color-border, #e9e5d7);\n  box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.08);\n  display: flex;\n  flex-direction: column;\n  z-index: 40;\n  transition: height 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n  font-family: inherit;\n  color: var(--color-text-primary, #252b2c);\n}\n.analysis-results-panel.is-expanded[data-v-c50f7cc4] {\n  height: 480px;\n}\n.analysis-results-panel.is-minimized[data-v-c50f7cc4] {\n  height: 42px;\n  overflow: hidden;\n}\n.analysis-results-panel.is-minimized .panel-body[data-v-c50f7cc4],\n.analysis-results-panel.is-minimized .panel-alert[data-v-c50f7cc4] {\n  display: none !important;\n}\n.analysis-results-panel.is-stale[data-v-c50f7cc4] {\n  border-top: 2px solid #f59e0b;\n}\n\n/* Header */\n.panel-header[data-v-c50f7cc4] {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 16px;\n  background: var(--color-surface, #fffef8);\n  border-bottom: 1px solid var(--color-border, #e9e5d7);\n  gap: 12px;\n}\n.header-left[data-v-c50f7cc4] {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 200px;\n}\n.panel-title[data-v-c50f7cc4] {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--color-text-primary, #252b2c);\n}\n.status-badge[data-v-c50f7cc4] {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 3px 8px;\n  border-radius: 9999px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n.badge-solved[data-v-c50f7cc4] {\n  background: #dcfce7;\n  color: #15803d;\n  border: 1px solid #bbf7d0;\n}\n.badge-stale[data-v-c50f7cc4] {\n  background: #fef3c7;\n  color: #b45309;\n  border: 1px solid #fde68a;\n}\n.units-chip[data-v-c50f7cc4] {\n  font-size: 11px;\n  color: #64748b;\n  background: #f1f5f9;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n/* Tabs */\n.header-center[data-v-c50f7cc4] {\n  flex: 1;\n  display: flex;\n  justify-content: center;\n}\n.panel-tabs[data-v-c50f7cc4] {\n  display: inline-flex;\