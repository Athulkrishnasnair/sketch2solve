","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide sparkle-amber lucide-sparkles-icon lucide-sparkles sparkle-amber","aria-hidden":"true"},["path",{"d":"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"}],["path",{"d":"M20 2v4"}],["path",{"d":"M22 4h-4"}],["circle",{"cx":"4","cy":"20","r":"2"}]],["SPAN",{"data-v-64e743d5":""},"Root Cause Explanation"]],["P",{"data-v-64e743d5":"","class":"explanation-quote"},"The structure has only 0 support constraint(s). Planar 2D static equilibrium requires at least 3 non-parallel reaction components to prevent rigid-body translation and rotation."],["P",{"data-v-64e743d5":"","class":"rationale-note"},"Under static equilibrium equations (ΣFx = 0, ΣFy = 0, ΣM = 0), a 2D planar body possesses 3 rigid-body degrees of freedom. Without 3 non-concurrent, non-parallel constraints, the equilibrium coefficient matrix is rank-deficient and cannot resist arbitrary loads."],["DIV",{"data-v-64e743d5":"","class":"fixes-group"},["SPAN",{"data-v-64e743d5":"","class":"fixes-heading"},"Proposed Repair:"],"",["DIV",{"data-v-64e743d5":"","class":"fix-item active"},["DIV",{"data-v-64e743d5":"","class":"fix-item-top"},["SPAN",{"data-v-64e743d5":"","class":"fix-radio-dot selected"}],["STRONG",{"data-v-64e743d5":"","class":"fix-name"},"Apply standard support layout: Pin at J1, Roller at J2"],["SPAN",{"data-v-64e743d5":"","class":"badge-valid"},"Valid Schema"]],["P",{"data-v-64e743d5":"","class":"fix-summary-text"},"Assigns a Pin Support (restraining X & Y) at Joint J1 and a Roller Support (restraining Y) at Joint J2, providing the 3 non-parallel reaction components required for stable equilibrium."],["DIV",{"data-v-64e743d5":"","class":"change-tags"},"",["SPAN",{"data-v-64e743d5":"","class":"elem-pill pill-node"}," Joint J1"],["SPAN",{"data-v-64e743d5":"","class":"elem-pill pill-node"}," Joint J2"],"","","","",["SPAN",{"data-v-64e743d5":"","class":"elem-pill pill-support"}," Support S_pin"],["SPAN",{"data-v-64e743d5":"","class":"elem-pill pill-support"}," Support S_roller"],""]],""],["DIV",{"data-v-64e743d5":"","class":"alternatives-wrapper"},["SPAN",{"data-v-64e743d5":"","class":"alt-title"},"Alternative approaches:"],["UL",{"data-v-64e743d5":"","class":"alt-bullet-list"},"",["LI",{"data-v-64e743d5":""},"Alternative: Replace a roller support with a fixed pin support if horizontal thrust restraint is available at both abutments."],["LI",{"data-v-64e743d5":""},"Alternative: If an inclined roller is intended, specify the normal constraint direction explicitly."],""]]]],["FOOTER",{"data-v-64e743d5":"","class":"card-footer"},["DIV",{"data-v-64e743d5":"","class":"action-approval-row"},["BUTTON",{"data-v-64e743d5":"","class":"btn-apply-fix","type":"button"},["svg",{"data-v-64e743d5":"","xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-check-icon lucide-check","aria-hidden":"true"},["path",{"d":"M20 6 9 17l-5-5"}]],["SPAN",{"data-v-64e743d5":""},"Apply Suggested Fix"]],["BUTTON",{"data-v-64e743d5":"","class":"btn-cancel-fix","type":"button"}," Cancel "]]]],[[51,210]]]]],[[51,214]],[[52,9]]],[[17,7]]]]]],[[53,313]],[[53,314]]]],"viewport":{"width":1280,"height":720},"timestamp":44196.421,"wallTime":1793754825739,"collectionTime":2.7999999998137355,"resourceOverrides":[],"isMainFrame":true}}
