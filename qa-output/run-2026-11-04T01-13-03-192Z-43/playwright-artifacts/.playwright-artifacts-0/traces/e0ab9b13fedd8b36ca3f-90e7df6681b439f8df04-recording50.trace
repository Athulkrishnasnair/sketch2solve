 0;\n  pointer-events: none;\n  z-index: 1200;\n}\n\n/* ─── Minimized Pill ─── */\n.assistant-minimized-pill[data-v-64e743d5] {\n  pointer-events: auto;\n  position: absolute;\n  bottom: calc(var(--statusbar-height) + 14px);\n  right: 24px;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 14px;\n  background: #fffef8;\n  border: 1px solid #e9e5d7;\n  border-radius: 999px;\n  box-shadow: 0 4px 14px rgba(41, 43, 41, 0.08);\n  font-size: 11px;\n  font-weight: 600;\n  color: #252b2c;\n  cursor: pointer;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n.assistant-minimized-pill[data-v-64e743d5]:hover {\n  transform: translateY(-1px);\n  border-color: #d6bd52;\n  box-shadow: 0 6px 18px rgba(41, 43, 41, 0.12);\n}\n.pill-sparkle[data-v-64e743d5] { color: #d97706; display: grid; place-items: center;\n}\n.pill-count[data-v-64e743d5] { color: #b9574f; font-weight: 700;\n}\n.pill-action[data-v-64e743d5] {\n  background: #faf3d9;\n  color: #252b2c;\n  padding: 2px 8px;\n  border-radius: 999px;\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n}\n\n/* ─── Floating Contextual Action Card ─── */\n.contextual-action-card[data-v-64e743d5] {\n  pointer-events: auto;\n  position: absolute;\n  max-width: 350px;\n  width: calc(100% - 32px);\n  background: #fffef8; /* Warm off-white */\n  border: 1px solid #e9e5d7;\n  border-radius: 12px;\n  box-shadow: 0 10px 28px rgba(41, 43, 41, 0.14), 0 2px 6px rgba(41, 43, 41, 0.04);\n  color: #252b2c;\n  overflow: hidden;\n  max-height: min(480px, calc(100% - 24px));\n  display: flex;\n  flex-direction: column;\n  overscroll-behavior: contain;\n  transition: left 0.15s ease-out, top 0.15s ease-out;\n  box-sizing: border-box;\n}\n\n/* ─── Header ─── */\n.card-header[data-v-64e743d5] {\n  flex-shrink: 0;\n  padding: 8px 12px;\n  background: #faf8ee;\n  border-bottom: 1px solid #e9e5d7;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.header-left[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.classification-pill[data-v-64e743d5] {\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  padding: 2px 6px;\n  border-radius: 4px;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n.badge-danger[data-v-64e743d5] {\n  background: #f8ecea;\n  color: #b9574f;\n  border: 1px solid #f2d4d0;\n}\n.badge-warning[data-v-64e743d5] {\n  background: #faf3d9;\n  color: #78350f;\n  border: 1px solid #f3e6b5;\n}\n.badge-mechanism[data-v-64e743d5] {\n  background: #ede9fe;\n  color: #5b21b6;\n  border: 1px solid #ddd6fe;\n}\n.issue-step-counter[data-v-64e743d5] {\n  font-size: 9.5px;\n  font-family: ui-monospace, monospace;\n  color: #788181;\n  background: #fdfcf5;\n  border: 1px solid #e9e5d7;\n  padding: 1px 5px;\n  border-radius: 3px;\n}\n.header-controls[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n}\n.nav-cluster[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n}\n.icon-btn[data-v-64e743d5] {\n  border: 0;\n  background: transparent;\n  width: 22px;\n  height: 22px;\n  border-radius: 4px;\n  display: grid;\n  place-items: center;\n  color: #788181;\n  cursor: pointer;\n  transition: background 0.1s ease, color 0.1s ease;\n}\n.icon-btn[data-v-64e743d5]:hover:not(:disabled) {\n  background: #e9e5d7;\n  color: #252b2c;\n}\n.icon-btn[data-v-64e743d5]:disabled {\n  opacity: 0.3;\n  cursor: not-allowed;\n}\n.btn-clear-highlight[data-v-64e743d5]:hover {\n  background: #fee2e2;\n  color: #dc2626;\n}\n\n/* ─── Body (Independently Scrollable) ─── */\n.card-body[data-v-64e743d5],\n.card-content-scroll[data-v-64e743d5] {\n  flex: 1 1 auto;\n  min-height: 0;\n  padding: 10px 12px;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.card-content-scroll[data-v-64e743d5]::-webkit-scrollbar {\n  width: 5px;\n}\n.card-content-scroll[da