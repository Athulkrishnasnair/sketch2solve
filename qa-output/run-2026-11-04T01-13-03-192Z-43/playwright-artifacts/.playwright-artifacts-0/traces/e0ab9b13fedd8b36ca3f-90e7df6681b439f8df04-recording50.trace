erflow: hidden; color: #343731; font: 600 13px var(--heading); text-overflow: ellipsis; white-space: nowrap;\n}\n.overview-note[data-v-ec0fe1c5] { margin-left: auto; color: #9a9b8e; font-size: 8px; text-align: right;\n}\n.review-icon[data-v-ec0fe1c5] { color: #437768; background: #e8f1e8;\n}\n.solver-card[data-v-ec0fe1c5] { color: #fff9e8; background: #2a2b29; border-color: #2a2b29;\n}\n.solver-card .solver-icon[data-v-ec0fe1c5] { color: #e8d16e; background: #41413a;\n}\n.solver-card small[data-v-ec0fe1c5] { color: #b8b6a6;\n}\n.solver-card strong[data-v-ec0fe1c5] { color: #fff9e7;\n}\n.solver-card .overview-note[data-v-ec0fe1c5] { color: #c1bd9d;\n}\n.failure-card[data-v-ec0fe1c5] { background: #2a2b29; border-color: #2a2b29;\n}\n.failure-card .failure-icon[data-v-ec0fe1c5] { color: #f1d36f; background: #41413a;\n}\n.failure-card small[data-v-ec0fe1c5] { color: #b8b6a6;\n}\n.failure-card strong[data-v-ec0fe1c5] { color: #fff9e7;\n}\n.failure-card button[data-v-ec0fe1c5] { width: 26px; height: 26px; margin-left: auto; border: 1px solid #55564f; border-radius: 50%; color: #f8e7a3; background: transparent; cursor: pointer;\n}\n.recent-work-section[data-v-ec0fe1c5] { margin-top: 6px;\n}\n.recent-work-heading[data-v-ec0fe1c5] { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 13px;\n}\n.recent-work-heading .eyebrow[data-v-ec0fe1c5] { margin-bottom: 5px;\n}\n.recent-work-heading h2[data-v-ec0fe1c5] { color: #30332e; font: 650 19px var(--heading); letter-spacing: -.5px;\n}\n.recent-work-heading h2 span[data-v-ec0fe1c5] { display: inline-grid; min-width: 22px; height: 22px; margin-left: 5px; place-items: center; vertical-align: 2px; border-radius: 50%; color: #777968; background: #eeeddf; font: 9px var(--mono);\n}\n.dashboard-state[data-v-ec0fe1c5], .dashboard-empty[data-v-ec0fe1c5] { min-height: 145px; display: flex; align-items: center; justify-content: center; gap: 20px; padding: 23px; border: 1px dashed #dedccc; border-radius: 17px; color: #858477; background: #fffef7a8;\n}\n.dashboard-state[data-v-ec0fe1c5] { flex-direction: column; gap: 4px;\n}\n.dashboard-state p[data-v-ec0fe1c5], .dashboard-empty p[data-v-ec0fe1c5] { margin: 5px 0 0; color: #939285; font-size: 10px;\n}\n.dashboard-state strong[data-v-ec0fe1c5], .dashboard-empty strong[data-v-ec0fe1c5] { color: #4e5048; font: 650 13px var(--heading);\n}\n.dashboard-error[data-v-ec0fe1c5] { border-color: #ead0c8; color: #a3554d;\n}\n.dashboard-error p[data-v-ec0fe1c5] { max-width: 540px;\n}\n.dashboard-error button[data-v-ec0fe1c5] { margin-top: 7px; border: 0; color: #81564d; background: transparent; font-weight: 700; cursor: pointer;\n}\n.empty-sketch[data-v-ec0fe1c5] { width: 95px; flex: 0 0 auto;\n}\n.empty-sketch svg[data-v-ec0fe1c5] { width: 100%; stroke: #9ba58c; stroke-width: 1.4;\n}\n.empty-sketch circle[data-v-ec0fe1c5] { fill: #f1d86e; stroke: #87917b;\n}\n.dashboard-empty > div[data-v-ec0fe1c5]:nth-child(2) { flex: 1;\n}\n.recent-analysis-grid[data-v-ec0fe1c5] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; gap: 12px;\n}\n.recent-analysis-card[data-v-ec0fe1c5] { min-width: 0; display: flex; flex-direction: column; overflow: hidden; padding: 0; border: 1px solid #e8e5d9; border-radius: 15px; color: inherit; background: #fffef9; box-shadow: 0 3px 10px #3b362508; text-align: left; cursor: pointer; transition: transform .16s ease, box-shadow .16s ease;\n}\n.recent-analysis-card[data-v-ec0fe1c5]:hover { transform: translateY(-2px); box-shadow: 0 8px 18px #3b362511;\n}\n.analysis-thumb[data-v-ec0fe1c5] { height: 126px; position: relative; display: grid; place-items: center; overflow: hidden; background: #e8e7de;\n}\n.analysis-thumb img[data-v-ec0fe1c5] { width: 100%; height: 100%; padding: 6px; object-fit: contain;\n}\n.thumb-index[data-v-ec0fe1c5] { position: absolute; top: 9px; left: 9px; padding: 5px 7px; border: 1px solid #ffffffa3; border-radius: 99px; color: #45483f; background: 