c39350; border-radius: 50%; }\n.visual-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.visual-card { min-width: 0; overflow: hidden; border: 1px solid #e1e7e2; border-radius: 8px; background: #fff; }\n.visual-card-heading { min-height: 54px; padding: 9px 11px; display: flex; justify-content: space-between; align-items: center; gap: 8px; border-bottom: 1px solid #e9edea; }\n.visual-card-heading > div { display: flex; align-items: center; gap: 9px; min-width: 0; }\n.visual-index { width: 22px; height: 22px; border-radius: 6px; display: grid; place-items: center; flex: 0 0 auto; color: #66756d; background: #eef2ee; font: 10px var(--mono); }\n.index-vision { color: #237e79; background: #e8f4f2; }\n.index-ai { color: #a36e37; background: #f7eee3; }\n.visual-card-heading strong { display: block; color: #43504b; font-size: 10px; white-space: nowrap; }\n.visual-card-heading small { display: block; color: #9aa39f; font: 8px var(--mono); margin-top: 3px; }\n.count-label { color: #86928d; font: 8px var(--mono); white-space: nowrap; }\n.open-image { width: 25px; height: 25px; border: 1px solid #e4e9e5; border-radius: 5px; display: grid; place-items: center; color: #687a71; text-decoration: none; font-size: 13px; }\n.open-image:hover { background: #f1f6f1; }\n.visual-stage { width: 100%; position: relative; overflow: auto; background-color: #eeefeb; background-image: linear-gradient(45deg, #e7e9e4 25%, transparent 25%), linear-gradient(-45deg, #e7e9e4 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e7e9e4 75%), linear-gradient(-45deg, transparent 75%, #e7e9e4 75%); background-size: 18px 18px; background-position: 0 0, 0 9px, 9px -9px, -9px 0; min-height: 145px; max-height: 290px; }\n.visual-stage img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: fill; display: block; }\n.overlay-svg { width: 100%; height: 100%; position: absolute; inset: 0; overflow: visible; }\n.visual-stage img, .visual-stage .over