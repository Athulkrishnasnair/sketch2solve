e: 11px;\n  font-weight: 500;\n  color: #475569;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n.header-action-btn[data-v-c50f7cc4]:hover {\n  background: #f1f5f9;\n  color: #1e293b;\n}\n.header-action-btn.active[data-v-c50f7cc4] {\n  background: #e0f2fe;\n  color: #0369a1;\n  border-color: #bae6fd;\n}\n.header-action-btn.btn-close[data-v-c50f7cc4]:hover {\n  background: #fee2e2;\n  color: #b91c1c;\n  border-color: #fca5a5;\n}\n\n/* Export Dropdown */\n.export-dropdown-container[data-v-c50f7cc4] {\n  position: relative;\n  display: inline-flex;\n}\n.export-menu[data-v-c50f7cc4] {\n  position: absolute;\n  bottom: calc(100% + 8px);\n  right: 0;\n  width: 260px;\n  background: #ffffff;\n  border: 1px solid var(--color-border, #e9e5d7);\n  border-radius: 8px;\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);\n  padding: 6px;\n  z-index: 100;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n.export-menu-header[data-v-c50f7cc4] {\n  padding: 6px 8px 4px 8px;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: #64748b;\n  border-bottom: 1px solid #f1f5f9;\n  margin-bottom: 2px;\n}\n.export-menu-item[data-v-c50f7cc4] {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  padding: 8px 10px;\n  border: none;\n  background: transparent;\n  border-radius: 6px;\n  cursor: pointer;\n  text-align: left;\n  transition: background 0.15s ease;\n  font-family: inherit;\n}\n.export-menu-item[data-v-c50f7cc4]:hover:not(:disabled) {\n  background: #f8fafc;\n}\n.export-menu-item.is-disabled[data-v-c50f7cc4],\n.export-menu-item[data-v-c50f7cc4]:disabled {\n  opacity: 0.55;\n  cursor: not-allowed;\n  background: #fafafa;\n}\n.export-item-icon[data-v-c50f7cc4] {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  border-radius: 6px;\n  background: #f1f5f9;\n  color: #334155;\n  flex-shrink: 0;\n}\n.ex