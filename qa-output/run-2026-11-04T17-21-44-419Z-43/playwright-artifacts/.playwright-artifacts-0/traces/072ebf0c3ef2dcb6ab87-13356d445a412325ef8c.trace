 align-items: center;\n  gap: 5px;\n}\n.legend-swatch[data-v-0ea7f51c] {\n  width: 12px;\n  height: 3px;\n  border-radius: 2px;\n}\n.legend-swatch.normal[data-v-0ea7f51c] { background: #292a28;\n}\n.legend-swatch.added[data-v-0ea7f51c] { background: #0284c7; border-top: 1px dashed #0284c7;\n}\n.legend-swatch.removal[data-v-0ea7f51c] { background: #ef4444;\n}\n.legend-swatch.support[data-v-0ea7f51c] { width: 8px; height: 8px; background: #606859; border-radius: 1px;\n}\n.canvas-loading[data-v-0ea7f51c], .canvas-empty[data-v-0ea7f51c] {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  color: #8b8e82;\n  font-size: 12px;\n}\n.canvas-empty p[data-v-0ea7f51c] {\n  margin: 0;\n  max-width: 320px;\n  text-align: center;\n  font-size: 11px;\n}\n.empty-icon[data-v-0ea7f51c] {\n  color: #c0bcae;\n}\n.spin-icon[data-v-0ea7f51c] {\n  animation: spin 1s linear infinite;\n}\n"],["STYLE",{},"\n.cdialog-backdrop[data-v-d3e333dd] {\n  position: fixed;\n  inset: 0;\n  z-index: 9000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(15, 23, 42, 0.4);\n  backdrop-filter: blur(2px);\n}\n.cdialog-panel[data-v-d3e333dd] {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-lg);\n  padding: var(--sp-6);\n  min-width: 320px;\n  max-width: 440px;\n  width: 90%;\n}\n.cdialog-title[data-v-d3e333dd] {\n  font-size: var(--text-md);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text-primary);\n  margin: 0 0 var(--sp-2);\n}\n.cdialog-message[data-v-d3e333dd] {\n  font-size: var(--text-base);\n  color: var(--color-text-secondary);\n  line-height: 1.55;\n  margin: 0 0 var(--sp-5);\n}\n.cdialog-actions[data-v-d3e333dd] {\n  display: flex;\n  gap: var(--sp-2);\n  justify-content: flex-end;\n}\n.cdialog-btn[data-v-d3e333dd] {\n  display: inline-flex;\n  align-items: center;\n  padding: 6px 16px;\n  font-size: var(--text-base);\n  font-weight: var(--weight-medium);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  transition: background var(--transition-base), border-color var(--transition-base);\n}\n.cdialog-cancel[data-v-d3e333dd] {\n  background: var(--color-neutral);\n  color: var(--color-text-secondary);\n  border: 1px solid var(--color-border-strong);\n}\n.cdialog-cancel[data-v-d3e333dd]:hover {\n  background: var(--color-neutral-hover);\n  color: var(--color-text-primary);\n}\n.cdialog-confirm[data-v-d3e333dd] {\n  background: var(--color-accent);\n  color: #fff;\n  border: 1px solid transparent;\n}\n.cdialog-confirm[data-v-d3e333dd]:hover {\n  background: var(--color-accent-hover);\n}\n.cdialog-confirm[data-v-d3e333dd]:focus-visible {\n  outline: 2px solid var(--color-accent);\n  outline-offset: 2px;\n}\n.cdialog-confirm--danger[data-v-d3e333dd] {\n  background: var(--color-danger);\n}\n.cdialog-confirm--danger[data-v-d3e333dd]:hover {\n  background: var(--color-danger-hover);\n}\n"],["STYLE",{},"\n.contextual-issue-wrapper[data-v-64e743d5] {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 1200;\n}\n\n/* ─── Minimized Pill ─── */\n.assistant-minimized-pill[data-v-64e743d5] {\n  pointer-events: auto;\n  position: absolute;\n  bottom: 16px;\n  right: 16px;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 14px;\n  background: #fffef8;\n  border: 1px solid #e9e5d7;\n  border-radius: 999px;\n  box-shadow: 0 4px 14px rgba(41, 43, 41, 0.08);\n  font-size: 11px;\n  font-weight: 600;\n  color: #252b2c;\n  cursor: pointer;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n.assistant-minimized-pill[data-v-64e743d5]:hover {\n  transform: translateY(-1px);\n  border-color: #d6bd52;\n  box-shadow: 0 6px 18px rgba(41, 43, 41, 0.12);\n}\n.pill-sparkle[data-v-64e743d5] { color: #d97706; display: grid; place-items: center;\n}\n.pill-count[data-v-64e743d5] { color: #b9574f; font-weight: 700;\n}\n.pill-action[data-v-64e743d5] {\n  background: #faf3d9;\n  color: #252b2c;\n  padding: 2px 8px;\n  border-radius: 999px;\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n}\n\n/* ─── Floating Contextual Action Card ─── */\n.contextual-action-card[data-v-64e743d5] {\n  pointer-events: auto;\n  position: absolute;\n  right: 16px;\n  bottom: 16px;\n  max-width: 360px;\n  width: calc(100% - 32px);\n  background: #fffef8; /* Warm off-white */\n  border: 1px solid #e9e5d7;\n  border-radius: 12px;\n  box-shadow: 0 10px 28px rgba(41, 43, 41, 0.14), 0 2px 6px rgba(41, 43, 41, 0.04);\n  color: #252b2c;\n  overflow: hidden;\n  max-height: min(480px, calc(100% - 32px));\n  display: flex;\n  flex-direction: column;\n  overscroll-behavior: contain;\n  box-sizing: border-box;\n}\n\n/* ─── Header ─── */\n.card-header[data-v-64e743d5] {\n  flex-shrink: 0;\n  padding: 8px 12px;\n  background: #faf8ee;\n  border-bottom: 1px solid #e9e5d7;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.header-left[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.classification-pill[data-v-64e743d5] {\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.4px;\n  padding: 2px 6px;\n  border-radius: 4px;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n.badge-danger[data-v-64e743d5] {\n  background: #f8ecea;\n  color: #b9574f;\n  border: 1px solid #f2d4d0;\n}\n.badge-warning[data-v-64e743d5] {\n  background: #faf3d9;\n  color: #78350f;\n  border: 1px solid #f3e6b5;\n}\n.badge-mechanism[data-v-64e743d5] {\n  background: #ede9fe;\n  color: #5b21b6;\n  border: 1px solid #ddd6fe;\n}\n.issue-step-counter[data-v-64e743d5] {\n  font-size: 9.5px;\n  font-family: ui-monospace, monospace;\n  color: #788181;\n  background: #fdfcf5;\n  border: 1px solid #e9e5d7;\n  padding: 1px 5px;\n  border-radius: 3px;\n}\n.header-controls[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n}\n.nav-cluster[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n}\n.icon-btn[data-v-64e743d5] {\n  border: 0;\n  background: transparent;\n  width: 22px;\n  height: 22px;\n  border-radius: 4px;\n  display: grid;\n  place-items: center;\n  color: #788181;\n  cursor: pointer;\n  transition: background 0.1s ease, color 0.1s ease;\n}\n.icon-btn[data-v-64e743d5]:hover:not(:disabled) {\n  background: #e9e5d7;\n  color: #252b2c;\n}\n.icon-btn[data-v-64e743d5]:disabled {\n  opacity: 0.3;\n  cursor: not-allowed;\n}\n.btn-clear-highlight[data-v-64e743d5]:hover {\n  background: #fee2e2;\n  color: #dc2626;\n}\n\n/* ─── Body (Independently Scrollable) ─── */\n.card-body[data-v-64e743d5],\n.card-content-scroll[data-v-64e743d5] {\n  flex: 1 1 auto;\n  min-height: 0;\n  padding: 10px 12px;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.card-content-scroll[data-v-64e743d5]::-webkit-scrollbar {\n  width: 5px;\n}\n.card-content-scroll[data-v-64e743d5]::-webkit-scrollbar-track {\n  background: transparent;\n}\n.card-content-scroll[data-v-64e743d5]::-webkit-scrollbar-thumb {\n  background: #d6d3c7;\n  border-radius: 4px;\n}\n.card-content-scroll[data-v-64e743d5]::-webkit-scrollbar-thumb:hover {\n  background: #b8b4a6;\n}\n\n/* ─── Sticky Action Footer ─── */\n.card-footer[data-v-64e743d5] {\n  flex-shrink: 0;\n  padding: 8px 12px;\n  background: #faf8ee;\n  border-top: 1px solid #e9e5d7;\n  border-radius: 0 0 12px 12px;\n}\n.issue-headline[data-v-64e743d5] {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.headline-title[data-v-64e743d5] {\n  font-size: 12px;\n  font-weight: 700;\n  color: #252b2c;\n}\n.issue-short-explanation[data-v-64e743d5] {\n  margin: 0;\n  font-size: 11.5px;\n  line-height: 1.4;\n  color: #3f4746;\n}\n\n/* ─── Affected Element Pills ─── */\n.affected-pills-row[data-v-64e743d5] {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 