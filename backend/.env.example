# Sketch2Solve Backend Environment Configuration

# Meta Model API Credentials (Required for AI perception, design studio, assistant)
MODEL_API_KEY=your_actual_meta_key
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Server Binding (Render automatically provides PORT; default local port is 5000)
# PORT=5000
# HOST=0.0.0.0
# FLASK_DEBUG=0

# Production CORS: Comma-separated list of allowed frontend origins (No wildcards)
# Example for Render static site:
# CORS_ORIGINS=https://sketch2solve.onrender.com,https://sketch2solve-frontend.onrender.com

# Persistence Configuration (Optional)
# Default is SQLite in the instance directory (ephemeral on free Render web services):
# DATABASE_URL=sqlite:///instance/sketch2solve.sqlite
# Render PostgreSQL or external PostgreSQL example (requires psycopg2-binary):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
# Upload directory for sketch images (defaults to instance/uploads):
# UPLOAD_FOLDER=/var/data/uploads
